NEXT_PUBLIC_SOULVAULT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SOULVAULT_CHAIN_ID=11155111
# These are transport only. Operative contract info (which contracts to listen
# to) is discovered at runtime from ENS: the org's soulvault.swarms /
# soulvault.treasuries records, the document registry via ENSIP-11 on the
# protocol root name, and the built-in Sepolia ERC-8004 identity registry.
# The legacy NEXT_PUBLIC_SOULVAULT_DEPLOYMENTS JSON list still parses but is
# never required.

# World Selfie Check on Documents → Rehydrate **request** (not unwrap).
# Unset = gate off (dev default; production shows a visible unconfigured warning).
# NEXT_PUBLIC_WORLD_GATE=required without an app id is a config error (fail closed).
# NEXT_PUBLIC_WORLD_GATE=off forces the gate off even if an app id is present.
# Public Portal ids (Soulvault external app). Signing key is server-only on the RP worker.
# NEXT_PUBLIC_WORLD_APP_ID=app_99dc82c37d167284ef081f8cdbe20222
# NEXT_PUBLIC_WORLD_RP_ID=rp_301afe7f18a97891
# NEXT_PUBLIC_WORLD_RP_URL=http://127.0.0.1:8787
# NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
# NEXT_PUBLIC_WORLD_GATE=off

# Skip Ledger's remote clear-signing enrichment (CAL descriptors, transaction-check
# scan, trusted-name lookup). Without a partner originToken these come back 403/422
# and each signature pays serial retry latency before degrading to blind signing —
# SoulVault payloads have no registered CAL descriptors either way. Set to 1 for
# fast dev signing (device shows the keccak hash prompt immediately).
# NEXT_PUBLIC_SOULVAULT_LEDGER_SKIP_CLEAR_SIGN=1
