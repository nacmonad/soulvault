{
	"name": "@soulvault/node",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SoulVault Node.js core: business-logic handlers shared by the CLI and server-side API routes. Contract wrappers, signer resolution (private-key/mnemonic/Ledger), 0G storage, ENS, and the ~/.soulvault state cache.",
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"test": "vitest run",
		"test:ens-name": "SOULVAULT_INTEGRATION=1 vitest run src/ens-name.integration.test.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:ledger": "vitest run --config vitest.ledger.integration.config.ts",
		"test:speculos": "vitest run --config vitest.speculos.integration.config.ts",
		"test:testnet": "SOULVAULT_TESTNET_INTEGRATION=1 vitest run --config vitest.integration.config.ts src/__integration__/fund-request-flow.testnet.test.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@0gfoundation/0g-ts-sdk": "^1.2.1",
		"@ledgerhq/context-module": "^1.15.0",
		"@ledgerhq/device-management-kit": "^1.2.0",
		"@ledgerhq/device-signer-kit-ethereum": "^1.13.0",
		"@ledgerhq/device-transport-kit-node-hid": "^1.0.0",
		"@soulvault/protocol": "workspace:*",
		"dotenv": "^16.6.1",
		"ethers": "6.13.1",
		"fs-extra": "^11.3.2",
		"tar": "^7.4.3",
		"viem": "^2.29.4",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@ledgerhq/device-transport-kit-speculos": "^1.2.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.5.0",
		"@types/tar": "^7.0.87",
		"typescript": "^6.0.2",
		"vitest": "^4.1.2"
	}
}
