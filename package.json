{
	"name": "soulvault",
	"private": true,
	"type": "module",
	"scripts": {
		"soulvault": "tsx apps/cli/src/index.ts",
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"slides:html": "mkdir -p slides/dist && marp slides/DECK.md --html --output slides/dist/deck.html",
		"slides:pdf": "mkdir -p slides/dist && marp slides/DECK.md --pdf --allow-local-files --output slides/dist/deck.pdf",
		"slides:pptx": "mkdir -p slides/dist && marp slides/DECK.md --pptx --allow-local-files --output slides/dist/deck.pptx",
		"slides:all": "npm run slides:html && npm run slides:pdf && npm run slides:pptx"
	},
	"dependencies": {
		"@0gfoundation/0g-ts-sdk": "^1.2.1",
		"dotenv": "^16.6.1",
		"ethers": "6.13.1"
	},
	"devDependencies": {
		"@marp-team/marp-cli": "^4.3.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"bufferutil",
			"esbuild",
			"node-hid",
			"usb",
			"utf-8-validate"
		]
	}
}
