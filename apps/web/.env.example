NEXT_PUBLIC_SOULVAULT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SOULVAULT_CHAIN_ID=11155111
# JSON array on Sepolia only. Empty [] is invalid and shows the config-error panel.
# Document flow needs a SoulVaultDocumentRegistry entry. Identity can be added now:
# {"kind":"identity","address":"0xfFb7D6E80E962f3A6c7FB29876C97c37F088a266","fromBlock":"10592315","label":"erc8004"}
# {"kind":"document","address":"0x...","fromBlock":"...","label":"docs"}
NEXT_PUBLIC_SOULVAULT_DEPLOYMENTS=[]

# World Selfie Check gate on Documents → Rehydrate (ticket 005).
# Unset = gate off (dev default; production shows a visible unconfigured warning).
# Set NEXT_PUBLIC_WORLD_APP_ID to require a credential-11 proof before unwrap.
# NEXT_PUBLIC_WORLD_GATE=required without an app id is a config error (fail closed).
# NEXT_PUBLIC_WORLD_GATE=off forces the gate off even if an app id is present.
# NEXT_PUBLIC_WORLD_APP_ID=app_xxxxx
# NEXT_PUBLIC_WORLD_GATE=off
