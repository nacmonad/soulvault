{
  "name": "soulvault-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "soulvault": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "^1.2.1",
    "@ledgerhq/context-module": "^2.5.0",
    "@ledgerhq/device-management-kit": "^1.2.0",
    "@ledgerhq/device-signer-kit-ethereum": "^1.13.0",
    "@ledgerhq/device-transport-kit-node-hid": "^1.0.0",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@scure/base": "^1.2.4",
    "@soulvault/node": "workspace:*",
    "@soulvault/protocol": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^16.6.1",
    "ethers": "6.13.1",
    "fs-extra": "^11.3.2",
    "tar": "^7.4.3",
    "viem": "^2.29.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "@types/tar": "^7.0.87",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "tsup": {
    "noExternal": ["@soulvault/node", "@soulvault/protocol"]
  }
}
